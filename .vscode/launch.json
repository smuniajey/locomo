{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open with Live Server",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5501/index.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start Live Server"
    },
    {
      "name": "Open index.html in Chrome",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    },
    {
      "name": "Open index.html in Edge",
      "type": "msedge",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    }
  ]
}
