// Module
___CSS_LOADER_EXPORT___.push([module.id, `/* Smooth scroll behavior */
html {
    scroll-behavior: smooth;
}

/* Custom animations */
@keyframes fade-in {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

@keyframes slide-up {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slide-up-delay {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fade-in-delay {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

.animate-fade-in {
    animation: fade-in 0.8s ease-out;
}

.animate-slide-up {
    animation: slide-up 0.8s ease-out;
}

.animate-slide-up-delay {
    animation: slide-up-delay 0.8s ease-out 0.2s both;
}

.animate-fade-in-delay {
    animation: fade-in-delay 0.8s ease-out 0.4s both;
}

/* Cursor hover effect for interactive elements */
button, a {
    cursor: pointer;
}

/* Disable text selection on buttons for better UX */
button {
    -webkit-user-select: none;
            user-select: none;
}

/* Custom scrollbar for webkit browsers */
::-webkit-scrollbar {
    width: 10px;
}

::-webkit-scrollbar-track {
    background: #0a0a0a;
}

::-webkit-scrollbar-thumb {
    background: #10b981;
    border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
    background: #059669;
}
`, "",{"version":3,"sources":["webpack://./src/App.css"],"names":[],"mappings":"AAAA,2BAA2B;AAC3B;IACI,uBAAuB;AAC3B;;AAEA,sBAAsB;AACtB;IACI;QACI,UAAU;IACd;IACA;QACI,UAAU;IACd;AACJ;;AAEA;IACI;QACI,UAAU;QACV,2BAA2B;IAC/B;IACA;QACI,UAAU;QACV,wBAAwB;IAC5B;AACJ;;AAEA;IACI;QACI,UAAU;QACV,2BAA2B;IAC/B;IACA;QACI,UAAU;QACV,wBAAwB;IAC5B;AACJ;;AAEA;IACI;QACI,UAAU;IACd;IACA;QACI,UAAU;IACd;AACJ;;AAEA;IACI,gCAAgC;AACpC;;AAEA;IACI,iCAAiC;AACrC;;AAEA;IACI,iDAAiD;AACrD;;AAEA;IACI,gDAAgD;AACpD;;AAEA,iDAAiD;AACjD;IACI,eAAe;AACnB;;AAEA,oDAAoD;AACpD;IACI,yBAAiB;YAAjB,iBAAiB;AACrB;;AAEA,yCAAyC;AACzC;IACI,WAAW;AACf;;AAEA;IACI,mBAAmB;AACvB;;AAEA;IACI,mBAAmB;IACnB,kBAAkB;AACtB;;AAEA;IACI,mBAAmB;AACvB","sourcesContent":["/* Smooth scroll behavior */\nhtml {\n    scroll-behavior: smooth;\n}\n\n/* Custom animations */\n@keyframes fade-in {\n    from {\n        opacity: 0;\n    }\n    to {\n        opacity: 1;\n    }\n}\n\n@keyframes slide-up {\n    from {\n        opacity: 0;\n        transform: translateY(30px);\n    }\n    to {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n@keyframes slide-up-delay {\n    from {\n        opacity: 0;\n        transform: translateY(30px);\n    }\n    to {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n@keyframes fade-in-delay {\n    from {\n        opacity: 0;\n    }\n    to {\n        opacity: 1;\n    }\n}\n\n.animate-fade-in {\n    animation: fade-in 0.8s ease-out;\n}\n\n.animate-slide-up {\n    animation: slide-up 0.8s ease-out;\n}\n\n.animate-slide-up-delay {\n    animation: slide-up-delay 0.8s ease-out 0.2s both;\n}\n\n.animate-fade-in-delay {\n    animation: fade-in-delay 0.8s ease-out 0.4s both;\n}\n\n/* Cursor hover effect for interactive elements */\nbutton, a {\n    cursor: pointer;\n}\n\n/* Disable text selection on buttons for better UX */\nbutton {\n    user-select: none;\n}\n\n/* Custom scrollbar for webkit browsers */\n::-webkit-scrollbar {\n    width: 10px;\n}\n\n::-webkit-scrollbar-track {\n    background: #0a0a0a;\n}\n\n::-webkit-scrollbar-thumb {\n    background: #10b981;\n    border-radius: 5px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n    background: #059669;\n}\n"],"sourceRoot":""}]);
